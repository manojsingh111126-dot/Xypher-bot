DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
CLIENT_SECRET=your-oauth2-client-secret
# Your dashboard's public URL (no trailing slash). Redirect URI to add in Discord = this + /callback
DASHBOARD_URL=https://spideydashboard.fadehost.app
# Optional: your test server ID for instant slash-command sync
GUILD_ID=
# 1 = main.py also starts the dashboard (recommended). 0 = bot only.
RUN_DASHBOARD=1
# Optional: dashboard port (hosts usually inject SERVER_PORT / PORT automatically)
# DASHBOARD_PORT=8080
